# ==============================================================================
# FLUXIFLOW FOR KITCHEN — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# --- DJANGO APPLICATION CONFIGURATION ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=insecure-dev-secret-key-change-in-production-fluxiflow
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# --- CORS SETTINGS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- POSTGRESQL DATABASE ---
POSTGRES_DB=fluxiflow_db
POSTGRES_USER=fluxiflow_user
POSTGRES_PASSWORD=fluxiflow_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# --- REDIS CONFIGURATION ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=

# --- CELERY CONFIGURATION ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- JWT CONFIGURATION ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=jwt-secret-key-change-in-production

# --- EMAIL CONFIGURATION ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025

# --- SECURITY / MFA CONFIGURATION ---
# MFA encryption key (Fernet key, generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MFA_ENCRYPTION_KEY=
